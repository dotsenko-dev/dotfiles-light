// Place your key bindings in this file to override the defaults
[
  {
    "key": "ctrl+v",
    "command": "editor.action.clipboardPasteAction",
    "when": "inQuickInput || inQuickOpen",
  },
  {
    "key": "ctrl+shift+v",
    "command": "editor.action.clipboardPasteAction",
    "when": "inQuickInput || inQuickOpen",
  },
  {
    "key": "ctrl+shift+v",
    "command": "-quicktype.pasteJSONAsTypesAndSerialization",
    "when": "editorTextFocus",
  },
  {
    "key": "ctrl+/",
    "command": "editor.action.commentLine",
    "when": "editorTextFocus",
  },
  {
    "key": "ctrl+k ctrl+s",
    "command": "workbench.action.openGlobalKeybindings",
  },

  {
    "key": "ctrl+p",
    "command": "-list.focusUp",
    "when": "listFocus && !inputFocus",
  },

  // --- ЗАКРИТТЯ ВКЛАДОК (VSCode fallback для не-текстових файлів) ---
  {
    "key": "space w",
    "command": "workbench.action.closeActiveEditor",
    "when": "!editorTextFocus && !terminalFocus && !inputFocus",
  },

  // --- РЕДАГУВАННЯ ТА ШВИДКІ ДІЇ ---
  // {
  //   "key": "escape",
  //   "command": "hideSuggestWidget",
  //   "when": "suggestWidgetVisible && textInputFocus",
  // },
  {
    "key": "alt+enter",
    "command": "editor.action.quickFix",
    "when": "editorHasCodeActionsProvider && textInputFocus && !editorReadonly",
  },
  {
    "key": "ctrl+oem_period",
    "command": "-editor.action.quickFix",
  },
  {
    "key": "ctrl+shift+w",
    "command": "-workbench.action.closeWindow",
  },

  // --- ФАЙЛОВА СИСТЕМА (Explorer) ---
  {
    "key": "alt+insert",
    "command": "explorer.newFile",
  },
  {
    "key": "alt+oem_7",
    "command": "explorer.newFile",
    "when": "explorerViewletVisible",
  },
  {
    "key": "alt+n",
    "command": "extension.advancedNewFile",
    "when": "!suggestWidgetVisible",
  },
  {
    "key": "alt+d",
    "command": "deleteFile",
    "when": "explorerViewletVisible && !inputFocus",
  },
  {
    "key": "alt+h",
    "command": "list.collapseAll",
    "when": "listFocus && !inputFocus",
  },

  // --- ПЕРЕМИКАННЯ ФОКУСУ ТА ПАНЕЛЕЙ ---
  {
    "key": "alt+oem_1",
    "command": "workbench.view.explorer",
    "when": "!sideBarFocus",
  },
  {
    "key": "alt+oem_1",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "sideBarFocus",
  },
  {
    "key": "shift+alt+oem_1",
    "command": "workbench.action.toggleSidebarVisibility",
  },
  {
    "key": "alt+,",
    "command": "workbench.action.openPreviousRecentlyUsedEditor",
  },
  {
    "key": "alt+.",
    "command": "workbench.action.openNextRecentlyUsedEditor",
  },

  // --- ТЕРМІНАЛ (Toggle Alt+J) ---
  {
    "key": "alt+j",
    "command": "workbench.action.terminal.toggleTerminal",
    "when": "!terminalFocus",
  },

  {
    "key": "alt+j",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "terminalFocus",
  },

  // --- ПРОБЛЕМИ (Toggle Alt+M) ---
  {
    "key": "alt+m",
    "command": "workbench.actions.view.problems",
    "when": "!focusedView || focusedView != 'workbench.panel.markers.view'",
  },
  {
    "key": "alt+m",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "focusedView == 'workbench.panel.markers.view'",
  },

  // --- РОБОТА ЗІ СПИСКАМИ (Selection) ---
  {
    "key": "shift+k",
    "command": "list.expandSelectionUp",
    "when": "listFocus && !inputFocus",
  },
  {
    "key": "shift+j",
    "command": "list.expandSelectionDown",
    "when": "listFocus && !inputFocus",
  },

  // --- ІНШЕ ---
  // Перевірка коміту - дописав ось це
  {
    "key": "alt+q",
    "command": "workbench.action.quickchat.toggle",
    "when": "chatIsEnabled",
  },
  {
    "key": "alt+]",
    "command": "search.action.focusNextSearchResult",
    "when": "hasSearchResult",
  },
  {
    "key": "alt+[",
    "command": "search.action.focusPreviousSearchResult",
    "when": "hasSearchResult",
  },
]
